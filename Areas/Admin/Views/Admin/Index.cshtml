@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid px-lg-5 mt-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="mb-1">Admin Dashboard</h2>
            <p class="text-muted mb-0">Khu vực quản trị chỉ dành cho tài khoản có quyền Admin.</p>
        </div>
        <a asp-area="" asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="fa-solid fa-store me-1"></i> Về trang bán hàng
        </a>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="text-muted small mb-2">Sản phẩm</div>
                    <div class="display-6 fw-bold text-danger">@ViewBag.ProductCount</div>
                    <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn btn-sm btn-danger mt-3">
                        Quản lý sản phẩm
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="text-muted small mb-2">Danh mục</div>
                    <div class="display-6 fw-bold text-primary">@ViewBag.CategoryCount</div>
                    <a asp-area="" asp-controller="Categories" asp-action="Index" class="btn btn-sm btn-outline-primary mt-3">
                        Quản lý danh mục
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="text-muted small mb-2">Đơn hàng</div>
                    <div class="display-6 fw-bold text-success">0</div>
                    <a asp-area="Admin" asp-controller="Order" asp-action="Index" class="btn btn-sm btn-outline-success mt-3">
                        Quản lý đơn hàng
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
