@model AdminUserDetailsViewModel

@{
    ViewData["Title"] = "Admin - Delete User";
}

<div class="container py-4">
    <h2 class="mb-4">Xóa tài khoản</h2>

    <div class="alert alert-warning">
        Bạn có chắc muốn xóa tài khoản <strong>@Model.Email</strong> không?
    </div>

    <dl class="row">
        <dt class="col-sm-3">Họ tên</dt>
        <dd class="col-sm-9">@Model.FullName</dd>

        <dt class="col-sm-3">Quyền</dt>
        <dd class="col-sm-9">@Model.Roles</dd>

        <dt class="col-sm-3">Trạng thái</dt>
        <dd class="col-sm-9">@(Model.IsLocked ? "Đã khóa" : "Hoạt động")</dd>
    </dl>

    <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-danger">Xóa</button>
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </form>
</div>
