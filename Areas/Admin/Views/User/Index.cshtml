@model IEnumerable<AdminUserListItemViewModel>

@{
    ViewData["Title"] = "Admin - Users";
}

<div class="container-fluid px-lg-5 mt-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="mb-1">Quản lý tài khoản</h2>
            <p class="text-muted mb-0">Thêm, xem, sửa quyền, khóa/mở khóa và xóa tài khoản người dùng.</p>
        </div>
        <a asp-action="Create" class="btn btn-danger rounded-pill px-4">
            <i class="fa-solid fa-user-plus me-1"></i> Thêm tài khoản
        </a>
    </div>

    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-warning">@TempData["Error"]</div>
    }

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle w-100">
                    <thead>
                        <tr>
                            <th>Email</th>
                            <th>Họ tên</th>
                            <th>Tuổi</th>
                            <th>Quyền</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@user.Email</td>
                                <td>@user.FullName</td>
                                <td>@user.Age</td>
                                <td>@user.Roles</td>
                                <td>
                                    @if (user.IsLocked)
                                    {
                                        <span class="badge bg-danger">Đã khóa</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Hoạt động</span>
                                    }
                                </td>
                                <td class="text-nowrap">
                                    <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-outline-info">Xem</a>
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                                    <form asp-action="ToggleLock" asp-route-id="@user.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-warning">
                                            @(user.IsLocked ? "Mở khóa" : "Khóa")
                                        </button>
                                    </form>
                                    <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger">Xóa</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
