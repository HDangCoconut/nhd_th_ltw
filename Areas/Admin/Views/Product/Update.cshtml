@model Product

@{
    ViewData["Title"] = "Admin - Edit Product";
    var existingImages = new List<(string Key, string Url, int? ImageId, bool IsPrimary)>();

    if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
    {
        existingImages.Add(("primary", Model.ImageUrl, null, true));
    }

    if (Model.Images is not null)
    {
        existingImages.AddRange(Model.Images
            .Where(image => !string.IsNullOrWhiteSpace(image.Url))
            .Where(image => !string.Equals(image.Url, Model.ImageUrl, StringComparison.OrdinalIgnoreCase))
            .Select(image => ($"image-{image.Id}", image.Url, (int?)image.Id, false)));
    }
}

<div class="container py-4">
    <h2 class="mb-4">Edit Product</h2>

    <div class="row g-4">
        <div class="col-lg-7">
            <form asp-action="Update" method="post" enctype="multipart/form-data" class="card border-0 shadow-sm rounded-4 p-4">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Price" class="form-label"></label>
                    <input asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label">Category</label>
                    <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                        <option value="">-- Select category --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>

                @if (existingImages.Any())
                {
                    <div class="mb-3">
                        <label class="form-label">Ảnh hiện tại</label>
                        <div class="d-flex flex-wrap gap-3">
                            @foreach (var image in existingImages)
                            {
                                <div class="product-image-preview-item text-center">
                                    <img src="@image.Url" alt="@Model.Name" class="product-edit-image rounded-3 border" />
                                    <div class="form-check mt-2">
                                        @if (image.IsPrimary)
                                        {
                                            <input class="form-check-input" type="checkbox" name="removePrimaryImage" value="true" id="removePrimaryImage" />
                                            <label class="form-check-label small" for="removePrimaryImage">Xóa ảnh đại diện</label>
                                        }
                                        else
                                        {
                                            <input class="form-check-input" type="checkbox" name="removedImageIds" value="@image.ImageId" id="remove-@image.Key" />
                                            <label class="form-check-label small" for="remove-@image.Key">Xóa ảnh</label>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="mb-3">
                    <label for="productImages" class="form-label">Thêm ảnh mới</label>
                    <input type="file" id="productImages" name="productImages" class="form-control" accept="image/*" multiple />
                    <div class="form-text">Có thể chọn nhiều ảnh cùng lúc.</div>
                    <span asp-validation-for="ImageUrl" class="text-danger"></span>
                    <div id="imagePreviewList" class="d-flex flex-wrap gap-3 mt-3"></div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Update</button>
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </form>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header fw-semibold">Tổng quan ảnh sản phẩm</div>
                <div class="card-body">
                    @if (existingImages.Any())
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var image in existingImages)
                            {
                                <img src="@image.Url" alt="@Model.Name" class="product-edit-image rounded-3 border" />
                            }
                        </div>
                    }
                    else
                    {
                        <div class="product-edit-image product-image-placeholder">Chưa có ảnh</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById("productImages").addEventListener("change", function (event) {
            const previewList = document.getElementById("imagePreviewList");
            previewList.innerHTML = "";

            Array.from(event.target.files).forEach(function (file, index) {
                const reader = new FileReader();
                reader.onload = function (readerEvent) {
                    const wrapper = document.createElement("div");
                    wrapper.className = "product-image-preview-item text-center";
                    wrapper.innerHTML = `
                        <img src="${readerEvent.target.result}" alt="Preview ${index + 1}" class="product-edit-image rounded-3 border" />
                        <div class="small text-muted mt-1">Ảnh mới ${index + 1}</div>`;
                    previewList.appendChild(wrapper);
                };
                reader.readAsDataURL(file);
            });
        });
    </script>
}
