@model Product

@{
    ViewData["Title"] = "Admin - Product Details";
    var imageUrls = new List<string>();

    if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
    {
        imageUrls.Add(Model.ImageUrl);
    }

    if (Model.Images is not null)
    {
        imageUrls.AddRange(Model.Images
            .Where(image => !string.IsNullOrWhiteSpace(image.Url))
            .Select(image => image.Url)
            .Where(url => !imageUrls.Contains(url, StringComparer.OrdinalIgnoreCase)));
    }
}

<div class="container py-4">
    <a asp-action="Index" class="btn btn-outline-secondary mb-4">
        <i class="fa-solid fa-arrow-left me-1"></i> Quay lại quản lý sản phẩm
    </a>

    <div class="card border-0 shadow-sm rounded-4 product-detail-card">
        <div class="row g-0">
            <div class="col-md-5 product-detail-image-wrapper p-4">
                @if (imageUrls.Any())
                {
                    <div id="adminProductImageCarousel" class="carousel slide product-gallery shadow-sm rounded-4 border bg-white" data-bs-ride="false">
                        <div class="carousel-inner">
                            @for (var index = 0; index < imageUrls.Count; index++)
                            {
                                var imageUrl = imageUrls[index];
                                <div class="carousel-item @(index == 0 ? "active" : "")">
                                    <img src="@imageUrl" alt="@Model.Name" class="d-block w-100 product-detail-image" />
                                </div>
                            }
                        </div>

                        @if (imageUrls.Count > 1)
                        {
                            <button class="carousel-control-prev" type="button" data-bs-target="#adminProductImageCarousel" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon"></span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#adminProductImageCarousel" data-bs-slide="next">
                                <span class="carousel-control-next-icon"></span>
                            </button>
                        }
                    </div>

                    @if (imageUrls.Count > 1)
                    {
                        <div class="d-flex flex-wrap justify-content-center gap-2 mt-3">
                            @for (var index = 0; index < imageUrls.Count; index++)
                            {
                                var imageUrl = imageUrls[index];
                                <button type="button"
                                        class="product-gallery-thumb @(index == 0 ? "active" : "")"
                                        data-bs-target="#adminProductImageCarousel"
                                        data-bs-slide-to="@index"
                                        aria-label="Xem ảnh @(index + 1)">
                                    <img src="@imageUrl" alt="@Model.Name" />
                                </button>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="product-detail-image product-image-placeholder rounded-3">No image</div>
                }
            </div>
            <div class="col-md-7">
                <div class="card-body p-4">
                    <h2 class="fw-bold">@Model.Name</h2>
                    <p class="badge bg-secondary px-3 py-2">SP@Model.Id.ToString("D4")</p>
                    <div class="h3 text-danger fw-bold my-3">@Model.Price.ToString("N0")đ</div>
                    <p class="text-muted">@Model.Description</p>
                    <p><strong>Danh mục:</strong> @Model.Category?.Name</p>
                    <p><strong>Số ảnh:</strong> @imageUrls.Count</p>
                    <div class="d-flex gap-2 mt-4">
                        <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Delete</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (imageUrls.Count > 1)
{
    @section Scripts {
        <script>
            const adminProductImageCarousel = document.getElementById("adminProductImageCarousel");
            if (adminProductImageCarousel) {
                adminProductImageCarousel.addEventListener("slide.bs.carousel", function (event) {
                    document.querySelectorAll(".product-gallery-thumb").forEach(function (thumb) {
                        thumb.classList.remove("active");
                    });

                    const activeThumb = document.querySelector(`.product-gallery-thumb[data-bs-slide-to="${event.to}"]`);
                    if (activeThumb) {
                        activeThumb.classList.add("active");
                    }
                });
            }
        </script>
    }
}