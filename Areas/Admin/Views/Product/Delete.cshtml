@model Product

@{
    ViewData["Title"] = "Admin - Xóa món ăn";
}

<div class="container py-4" style="max-width: 760px;">
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom border-light">
        <div>
            <h2 class="mb-1 fw-bold text-dark">Xác nhận xóa món ăn (Admin)</h2>
            <p class="text-muted mb-0">Hành động này sẽ xóa vĩnh viễn sản phẩm khỏi hệ thống.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">
            <i class="fa-solid fa-arrow-left"></i> Quay lại
        </a>
    </div>

    <!-- Danger Alert -->
    <div class="alert alert-danger d-flex align-items-center gap-3 rounded-4 mb-4 shadow-sm" role="alert" style="background-color: #fdf3f2; border-left: 5px solid #ff4722; color: #b71c1c;">
        <i class="fa-solid fa-triangle-exclamation fs-3"></i>
        <div>
            Bạn có chắc chắn muốn xóa vĩnh viễn món ăn <strong>@Model.Name</strong> ra khỏi cơ sở dữ liệu?
        </div>
    </div>

    <!-- Product Summary Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-body p-4 bg-white">
            <div class="row g-4 align-items-center">
                <div class="col-sm-4 text-center">
                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded-4 border p-1 shadow-sm" style="max-height: 180px; object-fit: contain;" />
                    }
                    else
                    {
                        <div class="rounded-4 border bg-light d-flex align-items-center justify-content-center mx-auto" style="width: 140px; height: 140px; color: var(--text-muted);">No image</div>
                    }
                </div>
                <div class="col-sm-8">
                    <table class="table table-borderless align-middle mb-0">
                        <tbody>
                            <tr>
                                <td class="fw-bold text-muted py-1" style="width: 120px;">Tên món ăn:</td>
                                <td class="fw-bold text-dark py-1">@Model.Name</td>
                            </tr>
                            <tr>
                                <td class="fw-bold text-muted py-1">Mã món:</td>
                                <td class="text-dark py-1">FOOD-@Model.Id.ToString("D2")</td>
                            </tr>
                            <tr>
                                <td class="fw-bold text-muted py-1">Giá bán:</td>
                                <td class="fw-bold text-danger py-1">@Model.Price.ToString("N0")đ</td>
                            </tr>
                            <tr>
                                <td class="fw-bold text-muted py-1">Danh mục:</td>
                                <td class="text-dark py-1">
                                    <span class="badge bg-warning-subtle text-warning-emphasis">
                                        <i class="fa-solid fa-tags me-1"></i>@(Model.Category?.Name ?? "Fastfood")
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td class="fw-bold text-muted py-1">Mô tả:</td>
                                <td class="text-muted py-1 small">@Model.Description</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Forms -->
    <form asp-action="DeleteConfirmed" method="post" class="d-flex gap-3">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger btn-lg rounded-pill px-4 py-2.5 fw-bold flex-grow-1" style="background-color: var(--accent-color); border-color: var(--accent-color);">
            <i class="fa-regular fa-trash-can me-1"></i> Đồng ý xóa món ăn
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill px-4 py-2.5">Hủy bỏ</a>
    </form>
</div>
