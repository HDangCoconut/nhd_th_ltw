@{
    ViewData["Title"] = "Admin - Orders";
}

<div class="container-fluid px-lg-5 mt-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="mb-1">Quản lý đơn hàng</h2>
            <p class="text-muted mb-0">Phần này đã tạo route và view Admin. Dữ liệu đơn hàng sẽ hoàn thiện ở bài giỏ hàng/đặt hàng.</p>
        </div>
        <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            Về Dashboard
