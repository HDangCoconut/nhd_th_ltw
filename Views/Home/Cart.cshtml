@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="container py-5">
    <h2 class="mb-4 fw-bold text-dark d-flex align-items-center gap-2">
        <i class="fa-solid fa-cart-shopping text-accent fs-3"></i><span>Giỏ hàng của bạn</span>
    </h2>

    <div class="row g-4">
        <!-- Cart Items List -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden">
                <div class="card-body p-4 bg-white">
                    <!-- Item 1 -->
                    <div class="row cart-item mb-4 g-3 align-items-center border-0 bg-transparent p-0">
                        <div class="col-md-2 col-4 text-center">
                            <img src="~/images/burger.png" alt="Burger Bò Phô Mai Hoàng Kim" class="img-fluid rounded-4 border p-1 bg-white shadow-sm" style="max-width: 90px; height: 90px; object-fit: cover;">
                        </div>

                        <div class="col-md-5 col-8">
                            <h5 class="fw-bold text-dark mb-1">Burger Bò Phô Mai Hoàng Kim</h5>
                            <p class="text-muted small mb-0"><i class="fa-solid fa-tags me-1 text-accent"></i>Danh mục: Burger & Bánh mì</p>
                        </div>

                        <div class="col-md-3 col-6 mt-3 mt-md-0">
                            <div class="input-group" style="max-width: 120px; height: 36px;">
                                <button class="btn btn-outline-secondary btn-sm d-flex align-items-center justify-content-center" style="width: 32px; border-top-left-radius: 8px; border-bottom-left-radius: 8px;" type="button" onclick="changeCartQty(this, -1)">-</button>
                                <input type="text" class="form-control form-control-sm text-center border-secondary fw-bold bg-white border-start-0 border-end-0" value="1" readonly>
                                <button class="btn btn-outline-secondary btn-sm d-flex align-items-center justify-content-center" style="width: 32px; border-top-right-radius: 8px; border-bottom-right-radius: 8px;" type="button" onclick="changeCartQty(this, 1)">+</button>
                            </div>
                        </div>

                        <div class="col-md-2 col-6 text-end mt-3 mt-md-0">
                            <p class="fw-bold text-danger mb-2" style="font-size: 1.1rem; color: var(--accent-color) !important;">89.000đ</p>
                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1.5 d-flex align-items-center gap-1 ms-auto" onclick="removeItem(this)">
                                <i class="fa-regular fa-trash-can"></i> Xóa
                            </button>
                        </div>
                    </div>

                    <hr class="my-4 opacity-50">

                    <!-- Item 2 -->
                    <div class="row cart-item g-3 align-items-center border-0 bg-transparent p-0">
                        <div class="col-md-2 col-4 text-center">
                            <img src="~/images/fried_chicken.png" alt="Gà Rán Giòn Cay Sốt Hàn" class="img-fluid rounded-4 border p-1 bg-white shadow-sm" style="max-width: 90px; height: 90px; object-fit: cover;">
                        </div>

                        <div class="col-md-5 col-8">
                            <h5 class="fw-bold text-dark mb-1">Gà Rán Giòn Cay Sốt Hàn</h5>
                            <p class="text-muted small mb-0"><i class="fa-solid fa-tags me-1 text-accent"></i>Danh mục: Gà Rán & Gà Nướng</p>
                        </div>

                        <div class="col-md-3 col-6 mt-3 mt-md-0">
                            <div class="input-group" style="max-width: 120px; height: 36px;">
                                <button class="btn btn-outline-secondary btn-sm d-flex align-items-center justify-content-center" style="width: 32px; border-top-left-radius: 8px; border-bottom-left-radius: 8px;" type="button" onclick="changeCartQty(this, -1)">-</button>
                                <input type="text" class="form-control form-control-sm text-center border-secondary fw-bold bg-white border-start-0 border-end-0" value="2" readonly>
                                <button class="btn btn-outline-secondary btn-sm d-flex align-items-center justify-content-center" style="width: 32px; border-top-right-radius: 8px; border-bottom-right-radius: 8px;" type="button" onclick="changeCartQty(this, 1)">+</button>
                            </div>
                        </div>

                        <div class="col-md-2 col-6 text-end mt-3 mt-md-0">
                            <p class="fw-bold text-danger mb-2" style="font-size: 1.1rem; color: var(--accent-color) !important;">158.000đ</p>
                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1.5 d-flex align-items-center gap-1 ms-auto" onclick="removeItem(this)">
                                <i class="fa-regular fa-trash-can"></i> Xóa
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary py-2.5 px-4 shadow-sm rounded-pill fw-semibold d-inline-flex align-items-center gap-2" style="font-size: 0.9rem;">
                <i class="fa-solid fa-arrow-left"></i>Tiếp tục mua sắm
            </a>
        </div>

        <!-- Order Summary & Coupons -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden">
                <div class="card-body p-4 bg-white">
                    <h5 class="fw-bold text-dark mb-4 border-bottom pb-3">Tóm tắt đơn hàng</h5>

                    <div class="d-flex justify-content-between mb-3 text-muted">
                        <span>Tạm tính</span>
                        <span class="fw-semibold text-dark">247.000đ</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3 text-muted align-items-center">
                        <span>Phí vận chuyển</span>
                        <span class="badge bg-success-subtle text-success fw-semibold px-2 py-1" style="font-size: 0.8rem;">Miễn phí</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3 text-muted">
                        <span>Giảm giá</span>
                        <span class="fw-semibold text-dark">0đ</span>
                    </div>

                    <hr class="my-3 opacity-50">

                    <div class="d-flex justify-content-between mb-4">
                        <strong class="text-dark">Tổng cộng</strong>
                        <strong class="text-danger fs-4" style="color: var(--accent-color) !important;">247.000đ</strong>
                    </div>

                    <button class="btn btn-accent w-100 btn-lg rounded-3 py-3 shadow-sm fw-semibold d-flex align-items-center justify-content-center gap-2" style="border-radius: 12px !important; font-size: 1.05rem;">
                        <i class="fa-solid fa-credit-card"></i>Thanh toán ngay
                    </button>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-body p-4 bg-white">
                    <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                        <i class="fa-solid fa-ticket text-accent"></i><span>Mã giảm giá</span>
                    </h6>

                    <div class="input-group" style="height: 42px;">
                        <input type="text" class="form-control border-secondary" placeholder="Nhập mã giảm giá..." style="border-top-left-radius: 12px; border-bottom-left-radius: 12px;">
                        <button class="btn btn-outline-secondary px-3" type="button" style="border-top-right-radius: 12px; border-bottom-right-radius: 12px; font-weight: 600;">Áp dụng</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function changeCartQty(btn, amount) {
            const input = btn.closest(".input-group").querySelector("input");
            let val = parseInt(input.value) + amount;
            if (isNaN(val) || val < 1) val = 1;
            input.value = val;
        }

        function removeItem(btn) {
            const row = btn.closest(".row.cart-item");
            if (row) {
                // Smooth fade out effect before removal
                row.style.transition = "all 0.4s ease";
                row.style.opacity = "0";
                row.style.transform = "translateX(-20px)";
                setTimeout(() => {
                    const hr = row.nextElementSibling;
                    if (hr && hr.tagName === "HR") {
                        hr.remove();
                    } else {
                        const prevHr = row.previousElementSibling;
                        if (prevHr && prevHr.tagName === "HR") {
                            prevHr.remove();
                        }
                    }
                    row.remove();
                }, 400);
            }
        }
    </script>
}
