@model IEnumerable<Product>

@{
    ViewData["Title"] = "Trang chủ";
    var categories = ViewBag.Categories as IEnumerable<Category> ?? Enumerable.Empty<Category>();
    var keyword = ViewBag.Keyword as string;
}

<div class="container-fluid mt-4 px-lg-5">
    <div class="row g-4">
        <div class="col-lg-3 col-md-4">
            <div class="list-group category-menu shadow-sm rounded-3 overflow-hidden">
                @if (categories.Any())
                {
                    foreach (var category in categories)
                    {
                        <a asp-controller="Categories"
                           asp-action="Display"
                           asp-route-id="@category.Id"
                           class="list-group-item list-group-item-action py-3 border-0 border-bottom">
                            <i class="fa-solid fa-tag me-2 text-secondary"></i> @category.Name
                        </a>
                    }
                }
                else
                {
                    <div class="list-group-item py-3 border-0 text-muted">Chưa có danh mục</div>
                }
            </div>
        </div>

        <div class="col-lg-6 col-md-8">
            <div id="storeCarousel" class="carousel slide shadow-sm rounded-4 overflow-hidden" data-bs-ride="carousel">
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#storeCarousel" data-bs-slide-to="0" class="active"></button>
                    <button type="button" data-bs-target="#storeCarousel" data-bs-slide-to="1"></button>
                    <button type="button" data-bs-target="#storeCarousel" data-bs-slide-to="2"></button>
                </div>
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <img src="~/images/quangcao_iphone.webp" class="d-block w-100" alt="Banner iPhone">
                    </div>
                    <div class="carousel-item">
                        <img src="~/images/huawei_deal.jpg" class="d-block w-100" alt="Banner Huawei">
                    </div>
                    <div class="carousel-item">
                        <img src="~/images/quangcao_oppo.webp" class="d-block w-100" alt="Banner Oppo">
                    </div>
                </div>

                <button class="carousel-control-prev" type="button" data-bs-target="#storeCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#storeCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            </div>
        </div>

        <div class="col-lg-3 col-md-12">
            <div class="card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body d-flex flex-column justify-content-between p-4">
                    <div>
                        <div class="d-flex align-items-center mb-3">
                            <img src="~/images/claudecode-color.png" class="rounded me-2" alt="Logo" style="width: 45px; height: 45px; object-fit: cover;">
                            <h6 class="mb-0 fw-bold text-dark">Chào mừng bạn!</h6>
                        </div>
                        <p class="small text-muted mb-3">Nhập hội thành viên để nhận voucher giảm giá cùng nhiều ưu đãi công nghệ.</p>
                        <div class="border-top pt-3">
                            <p class="small mb-2">🎓 <strong>Học sinh/sinh viên:</strong> Giảm thêm 500k</p>
                            <p class="small mb-0">💻 <strong>Sắm Laptop:</strong> Tặng balo và chuột</p>
                        </div>
                    </div>
                    <div class="mt-4">
                        <a asp-action="Add" class="btn btn-danger w-100 mb-2 py-2 fw-semibold">Thêm sản phẩm</a>
                        <a asp-controller="Categories" asp-action="Index" class="btn btn-outline-secondary w-100 py-2">Quản lý danh mục</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="container-fluid px-lg-5 mt-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h3 class="section-title border-start border-danger border-5 ps-3 mb-0 fw-bold text-dark">
            @(string.IsNullOrWhiteSpace(keyword) ? "Sản phẩm nổi bật" : $"Kết quả tìm kiếm: {keyword}")
        </h3>
    </div>

    @if (Model.Any())
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var product in Model)
            {
                <div class="col">
                    <div class="card product-card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                        <a asp-action="Display" asp-route-id="@product.Id" class="product-link">
                            <div class="position-relative bg-white">
                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl" class="card-img-top product-img" alt="@product.Name">
                                }
                                else
                                {
                                    <div class="card-img-top product-img product-image-placeholder">No image</div>
                                }
                                <span class="badge bg-danger position-absolute top-0 start-0 m-3 px-2 py-1 shadow-sm">Hot</span>
                            </div>
                            <div class="card-body p-3">
                                <h5 class="product-title text-truncate fw-bold mb-1">@product.Name</h5>
                                <p class="product-desc text-muted small mb-2">@product.Description</p>
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <span class="fw-bold text-danger product-price">@product.Price.ToString("N0")đ</span>
                                    <span class="badge bg-warning-subtle text-warning-emphasis px-2 py-1">
                                        <i class="fa-solid fa-star me-1"></i>4.9
                                    </span>
                                </div>
                            </div>
                        </a>
                        <div class="card-footer bg-white border-0 pt-0 pb-3 px-3">
                            <div class="d-grid gap-2">
                                <a asp-action="Display" asp-route-id="@product.Id" class="btn btn-danger rounded-pill py-2 fw-semibold">
                                    <i class="fa-solid fa-cart-shopping me-1"></i> Mua hàng
                                </a>
                                <a asp-action="Display" asp-route-id="@product.Id" class="btn btn-outline-secondary rounded-pill py-2 fw-semibold">Xem chi tiết</a>
                                <div class="btn-group">
                                    <a asp-action="Update" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">Chưa có sản phẩm nào để hiển thị.</div>
    }
</section>
