@model IEnumerable<Product>

@{
    ViewData["Title"] = "Trang chủ";
    var keyword = ViewBag.Keyword as string;
}

<div class="container-fluid mt-4 px-lg-5">
    <div class="row g-4">
        <div class="col-lg-3 col-md-4">
            <div class="list-group category-menu shadow-sm rounded-4 overflow-hidden">
                <a href="#" class="list-group-item list-group-item-action py-3 border-0 active">
                    <i class="fa-solid fa-hamburger me-2 text-accent"></i> Burger & Bánh mì kẹp
                </a>
                <a href="#" class="list-group-item list-group-item-action py-3 border-0">
                    <i class="fa-solid fa-drumstick-bite me-2 text-secondary"></i> Gà Rán & Gà Nướng
                </a>
                <a href="#" class="list-group-item list-group-item-action py-3 border-0">
                    <i class="fa-solid fa-cheese me-2 text-secondary"></i> Khoai Tây & Đồ Ăn Kèm
                </a>
                <a href="#" class="list-group-item list-group-item-action py-3 border-0">
                    <i class="fa-solid fa-glass-water me-2 text-secondary"></i> Thức Uống & Tráng Miệng
                </a>
            </div>
        </div>

        <div class="col-lg-6 col-md-8">
            <div id="storeCarousel" class="carousel slide shadow-sm" data-bs-ride="carousel">
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#storeCarousel" data-bs-slide-to="0" class="active"></button>
                    <button type="button" data-bs-target="#storeCarousel" data-bs-slide-to="1"></button>
                    <button type="button" data-bs-target="#storeCarousel" data-bs-slide-to="2"></button>
                </div>
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <img src="~/images/banner_burger.png" class="d-block w-100" alt="Banner Burger">
                    </div>
                    <div class="carousel-item">
                        <img src="~/images/banner_chicken.png" class="d-block w-100" alt="Banner Chicken">
                    </div>
                    <div class="carousel-item">
                        <img src="~/images/banner_combo.png" class="d-block w-100" alt="Banner Combo">
                    </div>
                </div>

                <button class="carousel-control-prev" type="button" data-bs-target="#storeCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#storeCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            </div>
        </div>

        <div class="col-lg-3 col-md-12">
            <div class="card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body d-flex flex-column justify-content-between p-4">
                    <div>
                        <div class="d-flex align-items-center mb-3">
                            <img src="~/images/logo_fastfood.png" class="rounded-circle me-2" alt="Logo" style="width: 45px; height: 45px; object-fit: cover;">
                            <h6 class="mb-0 fw-bold text-dark">Foodie Club!</h6>
                        </div>
                        <p class="small text-muted mb-3">Tham gia câu lạc bộ ăn uống Yummy Bite để nhận ngay voucher giảm 15% cùng hàng ngàn ưu đãi vị giác khác.</p>
                        <div class="border-top pt-3">
                            <p class="small mb-2">🎓 <strong>Học sinh/Sinh viên:</strong> Giảm giá 10%</p>
                            <p class="small mb-2">🛵 <strong>Đặt Online:</strong> Freeship bán kính 3km</p>
                            <p class="small mb-0">🍔 <strong>Thứ 4 Vui Vẻ:</strong> Mua 1 Tặng 1 Burger</p>
                        </div>
                    </div>
                    <div class="mt-4">
                        <a asp-action="Add" class="btn btn-accent w-100 mb-2 py-2 fw-semibold">Thêm món mới</a>
                        <a asp-controller="Categories" asp-action="Index" class="btn btn-outline-secondary w-100 py-2">Quản lý danh mục</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="container-fluid px-lg-5 mt-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h3 class="section-title border-start border-danger border-5 ps-3 mb-0 fw-bold text-dark">
            @(string.IsNullOrWhiteSpace(keyword) ? "Thực đơn nổi bật" : $"Kết quả tìm kiếm: {keyword}")
        </h3>
    </div>

    @if (Model.Any())
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var product in Model)
            {
                <div class="col">
                    <div class="card product-card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                        <a asp-action="Display" asp-route-id="@product.Id" class="product-link">
                            <div class="product-img-wrapper">
                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl" class="card-img-top product-img" alt="@product.Name">
                                }
                                else
                                {
                                    <div class="card-img-top product-img product-image-placeholder">No image</div>
                                }
                                <span class="badge bg-danger position-absolute top-0 start-0 m-3 px-2 py-1 shadow-sm">-20%</span>
                            </div>
                            <div class="card-body p-3">
                                <h5 class="product-title text-truncate fw-bold mb-1">@product.Name</h5>
                                <p class="product-desc text-muted small mb-2">@product.Description</p>
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <span class="fw-bold text-danger product-price">@product.Price.ToString("N0")đ</span>
                                    <span class="badge bg-warning-subtle text-warning-emphasis px-2 py-1">
                                        <i class="fa-solid fa-star me-1"></i>4.9
                                    </span>
                                </div>
                            </div>
                        </a>
                        <div class="card-footer bg-white border-0 pt-0 pb-3 px-3">
                            <div class="d-grid gap-2">
                                <a asp-action="Display" asp-route-id="@product.Id" class="btn btn-accent rounded-pill py-2 fw-semibold">
                                    <i class="fa-solid fa-cart-shopping me-1"></i> Mua hàng
                                </a>
                                <a asp-action="Display" asp-route-id="@product.Id" class="btn btn-outline-secondary rounded-pill py-2 fw-semibold">Xem chi tiết</a>
                                <div class="btn-group">
                                    <a asp-action="Update" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                                    <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger">Xóa</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">Chưa có sản phẩm nào để hiển thị.</div>
    }
</section>
