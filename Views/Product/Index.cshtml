@model IEnumerable<Product>

@{
    ViewData["Title"] = "Trang chủ";
    var keyword = ViewBag.Keyword as string;
    var categories = ViewBag.Categories as IEnumerable<Category>;
}

<div class="container-fluid mt-4 px-lg-5">
    <div class="row g-4">
        <!-- Sidebar Categories -->
        <div class="col-lg-3 col-md-4">
            <div class="list-group category-menu shadow-sm rounded-4 overflow-hidden border-0">
                <a href="#" class="list-group-item list-group-item-action py-3 border-0 active" data-category-id="all">
                    <i class="fa-solid fa-utensils me-2 text-accent"></i> Tất cả thực đơn
                </a>
                @if (categories is not null)
                {
                    foreach (var category in categories)
                    {
                        var iconClass = "fa-circle-chevron-right";
                        var iconColorClass = "text-secondary";
                        var lowerName = category.Name.ToLower();
                        if (lowerName.Contains("burger") || lowerName.Contains("bánh mì"))
                        {
                            iconClass = "fa-hamburger";
                            iconColorClass = "text-accent";
                        }
                        else if (lowerName.Contains("gà"))
                        {
                            iconClass = "fa-drumstick-bite";
                            iconColorClass = "text-warning";
                        }
                        else if (lowerName.Contains("nước") || lowerName.Contains("uống") || lowerName.Contains("trà"))
                        {
                            iconClass = "fa-glass-water";
                            iconColorClass = "text-info";
                        }
                        else if (lowerName.Contains("khoai") || lowerName.Contains("kèm") || lowerName.Contains("cheese"))
                        {
                            iconClass = "fa-cheese";
                            iconColorClass = "text-warning";
                        }

                        <a href="#" class="list-group-item list-group-item-action py-3 border-0" data-category-id="@category.Id">
                            <i class="fa-solid @iconClass me-2 @iconColorClass"></i> @category.Name
                        </a>
                    }
                }
            </div>
        </div>

        <!-- Hero Banners -->
        <div class="col-lg-6 col-md-8">
            <div id="storeCarousel" class="carousel slide shadow-sm border-0" data-bs-ride="carousel">
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#storeCarousel" data-bs-slide-to="0" class="active"></button>
                    <button type="button" data-bs-target="#storeCarousel" data-bs-slide-to="1"></button>
                    <button type="button" data-bs-target="#storeCarousel" data-bs-slide-to="2"></button>
                </div>
                <div class="carousel-inner rounded-4">
                    <div class="carousel-item active">
                        <img src="~/images/banner_burger.png" class="d-block w-100" alt="Banner Burger">
                    </div>
                    <div class="carousel-item">
                        <img src="~/images/banner_chicken.png" class="d-block w-100" alt="Banner Chicken">
                    </div>
                    <div class="carousel-item">
                        <img src="~/images/banner_combo.png" class="d-block w-100" alt="Banner Combo">
                    </div>
                </div>

                <button class="carousel-control-prev" type="button" data-bs-target="#storeCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#storeCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            </div>
        </div>

        <!-- Foodie Club Card -->
        <div class="col-lg-3 col-md-12">
            <div class="card border-0 shadow-sm h-100 rounded-4" style="background: linear-gradient(145deg, #ffffff, #fffdfb);">
                <div class="card-body d-flex flex-column justify-content-between p-4">
                    <div>
                        <div class="d-flex align-items-center mb-3">
                            <img src="~/images/logo_fastfood.png" class="rounded-circle me-2 border border-2 border-warning" alt="Logo" style="width: 45px; height: 45px; object-fit: cover;">
                            <h6 class="mb-0 fw-bold text-dark" style="font-size: 1.1rem;">Foodie Club!</h6>
                        </div>
                        <p class="small text-muted mb-3" style="line-height: 1.5;">Tham gia câu lạc bộ ăn uống <strong>Yummy Bite</strong> để nhận ngay voucher giảm 15% cùng hàng ngàn ưu đãi vị giác khác.</p>
                        <div class="pt-2">
                            <p class="small mb-2 d-flex align-items-center"><span class="me-2">🎓</span> <strong>Học sinh/Sinh viên:</strong> &nbsp;Giảm 10%</p>
                            <p class="small mb-2 d-flex align-items-center"><span class="me-2">🛵</span> <strong>Đặt Online:</strong> &nbsp;Freeship 3km</p>
                            <p class="small mb-0 d-flex align-items-center"><span class="me-2">🍔</span> <strong>Thứ 4 Vui Vẻ:</strong> &nbsp;Mua 1 Tặng 1</p>
                        </div>
                    </div>
                    <div class="mt-4 pt-3 border-top">
                        <a asp-action="Add" class="btn btn-accent w-100 mb-2 py-2 fw-semibold d-flex align-items-center justify-content-center gap-1">
                            <i class="fa-solid fa-plus"></i> Thêm món mới
                        </a>
                        <a asp-controller="Categories" asp-action="Index" class="btn btn-outline-secondary w-100 py-2 d-flex align-items-center justify-content-center gap-1">
                            <i class="fa-solid fa-list-check"></i> Quản lý danh mục
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Products Grid Section -->
<section class="container-fluid px-lg-5 mt-5">
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom border-light">
        <h3 class="section-title border-start border-danger border-4 ps-3 mb-0 fw-bold text-dark" id="menuTitle">
            @(string.IsNullOrWhiteSpace(keyword) ? "Thực đơn nổi bật" : $"Kết quả tìm kiếm: {keyword}")
        </h3>
        @if (!string.IsNullOrWhiteSpace(keyword))
        {
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Xóa bộ lọc tìm kiếm</a>
        }
    </div>

    @if (Model.Any())
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4" id="productsContainer">
            @foreach (var product in Model)
            {
                <div class="col product-item-col" data-category-id="@product.CategoryId">
                    <div class="card product-card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                        <a asp-action="Display" asp-route-id="@product.Id" class="product-link">
                            <div class="product-img-wrapper">
                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl" class="product-img" alt="@product.Name">
                                }
                                else
                                {
                                    <div class="product-img product-image-placeholder">No image</div>
                                }
                                <span class="badge bg-danger position-absolute top-0 start-0 m-3 px-2.5 py-1.5 shadow-sm rounded-3">FRESH</span>
                            </div>
                            <div class="card-body p-3">
                                <span class="badge bg-warning-subtle text-warning-emphasis px-2 py-1 mb-2" style="font-size: 0.75rem;">
                                    <i class="fa-solid fa-tags me-1"></i>@(product.Category?.Name ?? "Fastfood")
                                </span>
                                <h5 class="product-title text-truncate fw-bold mb-1 text-dark" style="font-size: 1.1rem;">@product.Name</h5>
                                <p class="product-desc text-muted mb-2">@product.Description</p>
                                <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top border-light">
                                    <span class="product-price">@product.Price.ToString("N0")đ</span>
                                    <span class="badge bg-warning-subtle text-warning-emphasis px-2 py-1" style="font-size: 0.8rem;">
                                        <i class="fa-solid fa-star me-1" style="color: #ffb703;"></i>4.9
                                    </span>
                                </div>
                            </div>
                        </a>
                        <div class="card-footer bg-white border-0 pt-0 pb-3 px-3">
                            <div class="d-grid gap-2">
                                <a asp-action="Display" asp-route-id="@product.Id" class="btn btn-accent rounded-pill py-2.5 fw-semibold d-flex align-items-center justify-content-center gap-1" style="font-size: 0.9rem;">
                                    <i class="fa-solid fa-cart-shopping"></i> Mua ngay
                                </a>
                                <div class="btn-group gap-1 mt-1">
                                    <a asp-action="Update" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary rounded-pill py-1.5 px-3" style="font-size: 0.8rem;"><i class="fa-regular fa-pen-to-square"></i> Sửa</a>
                                    <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger rounded-pill py-1.5 px-3" style="font-size: 0.8rem;"><i class="fa-regular fa-trash-can"></i> Xóa</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info py-4 text-center rounded-4 shadow-sm">
            <i class="fa-solid fa-circle-info fs-3 mb-2 text-primary"></i>
            <div>Không tìm thấy món ăn nào phù hợp với yêu cầu của bạn.</div>
        </div>
    }
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const categoryLinks = document.querySelectorAll(".category-menu [data-category-id]");
            const productCols = document.querySelectorAll(".product-item-col");
            const menuTitle = document.getElementById("menuTitle");

            categoryLinks.forEach(link => {
                link.addEventListener("click", function (e) {
                    e.preventDefault();

                    // Active state toggling
                    categoryLinks.forEach(l => l.classList.remove("active"));
                    this.classList.add("active");

                    const categoryId = this.getAttribute("data-category-id");
                    const categoryName = this.innerText.trim();

                    // Update title
                    if (categoryId === "all") {
                        menuTitle.innerText = "Thực đơn nổi bật";
                    } else {
                        menuTitle.innerText = "Món ăn: " + categoryName;
                    }

                    // Product visibility filtering
                    let visibleCount = 0;
                    productCols.forEach(col => {
                        const productCategoryId = col.getAttribute("data-category-id");
                        if (categoryId === "all" || productCategoryId === categoryId) {
                            col.style.display = "block";
                            col.style.opacity = "0";
                            setTimeout(() => {
                                col.style.transition = "opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1)";
                                col.style.opacity = "1";
                            }, 50);
                            visibleCount++;
                        } else {
                            col.style.display = "none";
                        }
                    });

                    // Manage empty search result visual
                    let emptyAlert = document.getElementById("emptyFilteredAlert");
                    if (visibleCount === 0) {
                        if (!emptyAlert) {
                            emptyAlert = document.createElement("div");
                            emptyAlert.id = "emptyFilteredAlert";
                            emptyAlert.className = "alert alert-info py-4 text-center rounded-4 shadow-sm w-100 mt-3";
                            emptyAlert.innerHTML = `<i class="fa-solid fa-face-frown fs-3 mb-2 text-primary"></i><div>Chưa có sản phẩm nào thuộc danh mục này.</div>`;
                            document.getElementById("productsContainer").after(emptyAlert);
                        }
                    } else if (emptyAlert) {
                        emptyAlert.remove();
                    }
                });
            });
        });
    </script>
}
