@model Product

@{
    ViewData["Title"] = Model.Name;
    var imageUrls = new List<string>();

    if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
    {
        imageUrls.Add(Model.ImageUrl);
    }

    if (Model.Images is not null)
    {
        imageUrls.AddRange(Model.Images
            .Where(image => !string.IsNullOrWhiteSpace(image.Url))
            .Select(image => image.Url)
            .Where(url => !imageUrls.Contains(url, StringComparer.OrdinalIgnoreCase)));
    }

    if (!imageUrls.Any())
    {
        imageUrls.Add("/images/burger.png");
    }

    var oldPrice = Model.Price * 1.25m;
}

<div class="container py-4">
    <a asp-action="Index" class="btn btn-outline-secondary mb-4 shadow-sm py-2.5 px-3 rounded-pill d-inline-flex align-items-center gap-2" style="font-size: 0.9rem;">
        <i class="fa-solid fa-arrow-left"></i> Quay lại thực đơn
    </a>

    <div class="row g-5">
        <!-- Gallery Images Left Side -->
        <div class="col-md-6 mb-4">
            @if (imageUrls.Any())
            {
                <div id="productImageCarousel" class="carousel slide product-gallery shadow-sm rounded-4 border-0 bg-white" data-bs-ride="false">
                    <div class="carousel-inner rounded-4">
                        @for (var index = 0; index < imageUrls.Count; index++)
                        {
                            var imageUrl = imageUrls[index];
                            <div class="carousel-item @(index == 0 ? "active" : "")">
                                <button type="button"
                                        class="product-gallery-main-image-button border-0 w-100"
                                        data-bs-toggle="modal"
                                        data-bs-target="#productImageModal"
                                        data-image-index="@index">
                                    <img src="@imageUrl" alt="@Model.Name" class="d-block w-100 product-image img-fluid" style="object-fit: contain; max-height: 400px; padding: 2rem;" />
                                </button>
                            </div>
                        }
                    </div>

                    @if (imageUrls.Count > 1)
                    {
                        <button class="carousel-control-prev" type="button" data-bs-target="#productImageCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon bg-dark rounded-circle p-2"></span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#productImageCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon bg-dark rounded-circle p-2"></span>
                        </button>
                    }
                </div>

                @if (imageUrls.Count > 1)
                {
                    <div class="d-flex flex-wrap justify-content-center gap-3 mt-3">
                        @for (var index = 0; index < imageUrls.Count; index++)
                        {
                            var imageUrl = imageUrls[index];
                            <button type="button"
                                    class="product-gallery-thumb @(index == 0 ? "active" : "") border-2"
                                    data-bs-target="#productImageCarousel"
                                    data-bs-slide-to="@index"
                                    aria-label="Xem ảnh @(index + 1)">
                                <img src="@imageUrl" alt="@Model.Name" />
                            </button>
                        }
                    </div>
                }
            }
            else
            {
                <div class="product-image product-image-placeholder rounded-4 shadow-sm border p-3 bg-white d-flex align-items-center justify-content-center" style="height: 380px;">No image</div>
            }
        </div>

        <!-- Info Details Right Side -->
        <div class="col-md-6">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-warning-subtle text-warning-emphasis px-3 py-1.5" style="font-size: 0.8rem; font-weight: 700;">
                    <i class="fa-solid fa-tags me-1"></i>@(Model.Category?.Name ?? "Fastfood")
                </span>
                <span class="badge bg-secondary mb-0 px-3 py-1.5" style="font-size: 0.8rem; background-color: rgba(62, 49, 40, 0.06) !important; color: var(--text-dark) !important;">Mã món: FOOD-@Model.Id.ToString("D2")</span>
            </div>

            <h2 class="fw-bold text-dark mb-2" style="font-size: 2.2rem; letter-spacing: -0.5px;">@Model.Name</h2>

            <div class="mb-3 d-flex align-items-center gap-2">
                <div class="text-warning">
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                </div>
                <span class="text-muted small" style="font-weight: 500;">5.0 (120 đánh giá thực khách)</span>
            </div>

            <div class="mb-4 bg-white p-3 rounded-4 border border-light d-flex align-items-baseline gap-3 shadow-sm" style="max-width: fit-content;">
                <span class="h2 fw-bold text-danger mb-0" style="font-size: 2.2rem; color: var(--accent-color) !important;">@Model.Price.ToString("N0")đ</span>
                <span class="text-muted text-decoration-line-through small" style="font-size: 1.1rem;">@oldPrice.ToString("N0")đ</span>
            </div>

            <p class="text-muted mb-4" style="line-height: 1.7; font-size: 1.05rem;">@Model.Description</p>

            <!-- Custom Size Choices -->
            <div class="mb-4">
                <h6 class="fw-bold text-dark mb-2.5"><i class="fa-solid fa-expand me-1.5 text-accent"></i>Kích cỡ:</h6>
                <div class="btn-group flex-wrap gap-2" role="group" style="box-shadow: none;">
                    <input type="radio" class="btn-check" name="size" id="sizeS" checked>
                    <label class="btn btn-outline-secondary px-4 py-2.5 rounded-pill" for="sizeS">Nhỏ (S)</label>

                    <input type="radio" class="btn-check" name="size" id="sizeM">
                    <label class="btn btn-outline-secondary px-4 py-2.5 rounded-pill" for="sizeM">Vừa (M) (+10K)</label>

                    <input type="radio" class="btn-check" name="size" id="sizeL">
                    <label class="btn btn-outline-secondary px-4 py-2.5 rounded-pill" for="sizeL">Lớn (L) (+20K)</label>
                </div>
            </div>

            <!-- Custom Quantity Input -->
            <div class="mb-4">
                <label for="quantity" class="form-label fw-bold text-dark mb-2"><i class="fa-solid fa-calculator me-1.5 text-accent"></i>Số lượng:</label>
                <div class="input-group" style="max-width: 140px; height: 42px;">
                    <button class="btn btn-outline-secondary d-flex align-items-center justify-content-center" style="border-top-left-radius: 12px; border-bottom-left-radius: 12px; width: 40px;" type="button" onclick="changeQty(-1)">-</button>
                    <input type="text" class="form-control text-center fw-bold border-secondary bg-white border-start-0 border-end-0" style="font-size: 1.1rem;" id="quantity" value="1" readonly>
                    <button class="btn btn-outline-secondary d-flex align-items-center justify-content-center" style="border-top-right-radius: 12px; border-bottom-right-radius: 12px; width: 40px;" type="button" onclick="changeQty(1)">+</button>
                </div>
            </div>

            <!-- Action buttons -->
            <div class="d-flex flex-wrap gap-3 mb-4 pt-2">
                <a asp-controller="Home" asp-action="Cart" class="btn btn-accent btn-lg flex-grow-1 py-3 px-4 rounded-3 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2" style="border-radius: 16px !important; font-size: 1.1rem;">
                    <i class="fa-solid fa-cart-plus"></i> Thêm vào giỏ hàng
                </a>
                <button type="button" class="btn btn-outline-secondary btn-lg py-3 px-4" style="border-radius: 16px !important; width: 60px; display: flex; align-items: center; justify-content: center;" onclick="toggleFavorite(this)">
                    <i class="fa-regular fa-heart fs-4"></i>
                </button>
            </div>

            <!-- Characteristics Grid -->
            <div class="mt-4 border-top pt-4">
                <h6 class="fw-bold text-dark mb-3">Đặc trưng món ăn của Yummy Bite:</h6>
                <ul class="ps-0 row g-2 m-0">
                    <li class="col-md-6 list-unstyled text-muted small d-flex align-items-center gap-2">
                        <i class="fa-solid fa-circle-check text-success fs-5"></i><span>Nguyên liệu sạch, chuẩn VietGAP</span>
                    </li>
                    <li class="col-md-6 list-unstyled text-muted small d-flex align-items-center gap-2">
                        <i class="fa-solid fa-circle-check text-success fs-5"></i><span>Chế biến ngay sau khi đặt hàng</span>
                    </li>
                    <li class="col-md-6 list-unstyled text-muted small d-flex align-items-center gap-2">
                        <i class="fa-solid fa-circle-check text-success fs-5"></i><span>Nước sốt đặc chế chuẩn năm sao</span>
                    </li>
                    <li class="col-md-6 list-unstyled text-muted small d-flex align-items-center gap-2">
                        <i class="fa-solid fa-circle-check text-success fs-5"></i><span>Đóng gói giữ nhiệt tốt, nóng hổi</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@if (imageUrls.Any())
{
    <div class="modal fade" id="productImageModal" tabindex="-1" aria-labelledby="productImageModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content bg-dark border-0 rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title text-white" id="productImageModalLabel">@Model.Name</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <div id="productImageModalCarousel" class="carousel slide" data-bs-ride="false">
                        <div class="carousel-inner rounded-3">
                            @for (var index = 0; index < imageUrls.Count; index++)
                            {
                                var imageUrl = imageUrls[index];
                                <div class="carousel-item @(index == 0 ? "active" : "")">
                                    <img src="@imageUrl" alt="@Model.Name" class="d-block mx-auto img-fluid rounded product-image-modal" style="max-height: 70vh; object-fit: contain;" />
                                </div>
                            }
                        </div>

                        @if (imageUrls.Count > 1)
                        {
                            <button class="carousel-control-prev" type="button" data-bs-target="#productImageModalCarousel" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon bg-dark rounded-circle p-2"></span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#productImageModalCarousel" data-bs-slide="next">
                                <span class="carousel-control-next-icon bg-dark rounded-circle p-2"></span>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function changeQty(amount) {
            const qtyInput = document.getElementById("quantity");
            let val = parseInt(qtyInput.value) + amount;
            if (isNaN(val) || val < 1) val = 1;
            qtyInput.value = val;
        }

        function toggleFavorite(btn) {
            const icon = btn.querySelector("i");
            if (icon.classList.contains("fa-regular")) {
                icon.className = "fa-solid fa-heart text-danger fs-4 animate__animated animate__heartBeat";
                btn.classList.add("border-danger");
            } else {
                icon.className = "fa-regular fa-heart fs-4";
                btn.classList.remove("border-danger");
            }
        }

        document.querySelectorAll(".product-gallery-main-image-button").forEach(function (button) {
            button.addEventListener("click", function () {
                const imageIndex = Number(button.dataset.imageIndex);
                const modalCarouselElement = document.getElementById("productImageModalCarousel");
                if (modalCarouselElement) {
                    const modalCarousel = bootstrap.Carousel.getOrCreateInstance(modalCarouselElement);
                    modalCarousel.to(imageIndex);
                }
            });
        });

        const productImageCarouselElement = document.getElementById("productImageCarousel");
        if (productImageCarouselElement) {
            productImageCarouselElement.addEventListener("slide.bs.carousel", function (event) {
                document.querySelectorAll(".product-gallery-thumb").forEach(function (thumb) {
                    thumb.classList.remove("active");
                });

                const activeThumb = document.querySelector(`.product-gallery-thumb[data-bs-slide-to="${event.to}"]`);
                if (activeThumb) {
                    activeThumb.classList.add("active");
                }
            });
        }
    </script>
}
