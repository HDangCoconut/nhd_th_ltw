@model IEnumerable<Product>

@{
    ViewData["Title"] = "Quản lý món ăn";
    var currentPage = Convert.ToInt32(ViewBag.CurrentPage ?? 1);
    var totalPages = Convert.ToInt32(ViewBag.TotalPages ?? 0);
    var totalItems = Convert.ToInt32(ViewBag.TotalItems ?? 0);
    var pageSize = Convert.ToInt32(ViewBag.PageSize ?? 10);
    var firstItem = totalItems == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    var lastItem = Math.Min(currentPage * pageSize, totalItems);

    string StripHtml(string? input)
    {
        if (string.IsNullOrEmpty(input)) return "";
        var stripped = System.Text.RegularExpressions.Regex.Replace(input, "<.*?>", string.Empty);
        return System.Net.WebUtility.HtmlDecode(stripped);
    }
}

<div class="container-fluid px-lg-5 mt-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">Quản lý món ăn</h2>
            <p class="text-muted mb-0">Danh sách món ăn đang hiển thị trên thực đơn.</p>
        </div>
        <a asp-action="Add" class="btn btn-accent rounded-pill px-4">
            <i class="fa-solid fa-plus me-1"></i> Thêm món mới
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <p class="text-muted mb-0">
                    Hiển thị @firstItem-@lastItem trong tổng số @totalItems dòng
                </p>
            </div>

            <div class="table-responsive">
                <table id="productsTable" class="table table-striped table-hover align-middle product-table w-100">
                    <thead>
                        <tr>
                            <th>Ảnh</th>
                            <th>Tên món</th>
                            <th>Giá</th>
                            <th>Danh mục</th>
                            <th>Mô tả</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl" alt="@product.Name" class="product-thumbnail" />
                                    }
                                    else
                                    {
                                        <div class="product-thumbnail product-image-placeholder">No image</div>
                                    }
                                </td>
                                <td class="fw-semibold">@product.Name</td>
                                <td data-order="@product.Price">@product.Price.ToString("N0")đ</td>
                                <td>@product.Category?.Name</td>
                                <td class="product-description">@StripHtml(product.Description)</td>
                                <td class="text-nowrap">
                                    <a asp-action="Display" asp-route-id="@product.Id" class="btn btn-sm btn-outline-accent">Xem</a>
                                    <a asp-action="Update" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                                    <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger">Xóa</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <nav class="mt-4" aria-label="Phân trang quản lý món ăn">
                    <ul class="pagination justify-content-center flex-wrap gap-1 mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="List"
                               asp-route-page="@(currentPage - 1)">Trước</a>
                        </li>

                        @for (var pageNumber = 1; pageNumber <= totalPages; pageNumber++)
                        {
                            <li class="page-item @(pageNumber == currentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-action="List"
                                   asp-route-page="@pageNumber">@pageNumber</a>
                            </li>
                        }

                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="List"
                               asp-route-page="@(currentPage + 1)">Sau</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>
