@model IEnumerable<Product>

@{
    ViewData["Title"] = "Quản lý món ăn";
}

<div class="container-fluid px-lg-5 mt-4">
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom border-light">
        <div>
            <h2 class="mb-1 fw-bold text-dark">Quản lý món ăn</h2>
            <p class="text-muted mb-0">Danh sách các món ăn hiện có trong thực đơn của hệ thống.</p>
        </div>
        <a asp-action="Add" class="btn btn-accent rounded-pill px-4 py-2.5 d-flex align-items-center gap-1">
            <i class="fa-solid fa-plus"></i> Thêm món mới
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-4 bg-white">
            <div class="table-responsive">
                <table id="productsTable" class="table table-hover align-middle product-table w-100">
                    <thead>
                        <tr>
                            <th style="width: 100px;">Ảnh</th>
                            <th>Tên món</th>
                            <th>Giá bán</th>
                            <th>Danh mục</th>
                            <th>Mô tả</th>
                            <th class="text-center" style="width: 240px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl" alt="@product.Name" class="product-thumbnail img-fluid rounded-3 border" style="width: 70px; height: 70px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="product-thumbnail product-image-placeholder rounded-3 border d-flex align-items-center justify-content-center" style="width: 70px; height: 70px; font-size: 0.75rem;">No image</div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@product.Name</div>
                                    <div class="text-muted small">ID: FOOD-@product.Id.ToString("D2")</div>
                                </td>
                                <td class="fw-bold text-danger" data-order="@product.Price">
                                    @product.Price.ToString("N0")đ
                                </td>
                                <td>
                                    <span class="badge bg-warning-subtle text-warning-emphasis px-2.5 py-1.5" style="font-size: 0.8rem;">
                                        <i class="fa-solid fa-tags me-1"></i>@(product.Category?.Name ?? "Chưa rõ")
                                    </span>
                                </td>
                                <td class="product-description text-truncate" style="max-width: 250px;">
                                    @product.Description
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="Display" asp-route-id="@product.Id" class="btn btn-sm btn-outline-accent rounded-pill px-3 py-1.5 d-flex align-items-center gap-1" style="font-size: 0.8rem;">
                                            <i class="fa-regular fa-eye"></i> Xem
                                        </a>
                                        <a asp-action="Update" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1.5 d-flex align-items-center gap-1" style="font-size: 0.8rem;">
                                            <i class="fa-regular fa-pen-to-square"></i> Sửa
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1.5 d-flex align-items-center gap-1" style="font-size: 0.8rem;">
                                            <i class="fa-regular fa-trash-can"></i> Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
