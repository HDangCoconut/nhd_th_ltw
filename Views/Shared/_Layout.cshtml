<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Yummy Bite</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NguyenHaiDang_W345.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark sticky-top px-3">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Product" asp-action="Index">
                    <img src="~/images/logo_fastfood.png" alt="Yummy Bite Logo" height="42" class="me-2 rounded-circle border border-2 border-warning shadow-sm">
                    <span>Yummy Bite</span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link text-white-50" asp-area="" asp-controller="Product" asp-action="Index">
                                <i class="fa-solid fa-house me-1"></i> Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50" asp-area="" asp-controller="Product" asp-action="Add">
                                <i class="fa-solid fa-plus me-1"></i> Thêm món
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50" asp-area="" asp-controller="Product" asp-action="List">
                                <i class="fa-solid fa-table me-1"></i> Quản lý món
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50" asp-area="" asp-controller="Categories" asp-action="Index">
                                <i class="fa-solid fa-list me-1"></i> Danh mục
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center flex-column flex-lg-row gap-3 mt-3 mt-lg-0">
                        <form class="d-flex m-0 position-relative" asp-controller="Product" asp-action="Index" method="get">
                            <input class="form-control rounded-pill pe-5 bg-white border-0" style="min-width: 240px; height: 40px; font-size: 0.9rem;" type="search" name="keyword" placeholder="Thèm món gì nè..." value="@Context.Request.Query["keyword"]">
                            <button class="btn btn-accent rounded-pill position-absolute end-0 top-0 h-100 px-3 border-0 d-flex align-items-center justify-content-center" type="submit" style="border-top-left-radius: 0 !important; border-bottom-left-radius: 0 !important; background-color: var(--accent-color);">
                                <i class="fa-solid fa-magnifying-glass text-white"></i>
                            </button>
                        </form>

                        <a asp-area="" asp-controller="Home" asp-action="Cart" class="btn btn-outline-warning rounded-pill position-relative px-3 py-2 d-flex align-items-center gap-1 border-2" style="font-weight: 600; font-size: 0.9rem; color: var(--secondary-color); border-color: rgba(255, 183, 3, 0.4);">
                            <i class="fa-solid fa-cart-shopping"></i>
                            <span>Giỏ hàng</span>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger shadow-sm border border-2 border-dark" style="font-size: 0.75rem; padding: 0.35em 0.6em;">2</span>
                        </a>

                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white-50 py-5 mt-auto border-top border-secondary" style="background-color: #1e1713 !important;">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-5 col-md-6">
                    <h5 class="text-white fw-bold d-flex align-items-center mb-3">
                        <img src="~/images/logo_fastfood.png" alt="Logo" height="36" class="me-2 rounded-circle border border-2 border-warning">
                        Yummy Bite
                    </h5>
                    <p class="small text-white-50 lh-lg">
                        Hệ thống cửa hàng thức ăn nhanh cao cấp sử dụng nguyên liệu sạch, tươi ngon mỗi ngày. Bài tập thực hành Lập trình Web chất lượng cao.
                    </p>
                    <div class="d-flex gap-3 mt-3">
                        <a href="#" class="text-white-50 hover-text-warning"><i class="fab fa-facebook-f fs-5"></i></a>
                        <a href="#" class="text-white-50 hover-text-warning"><i class="fab fa-instagram fs-5"></i></a>
                        <a href="#" class="text-white-50 hover-text-warning"><i class="fab fa-youtube fs-5"></i></a>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 ms-lg-auto">
                    <h6 class="text-white fw-bold mb-3">Liên kết nhanh</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                        <li><a asp-controller="Product" asp-action="Index" class="text-white-50 text-decoration-none small hover-text-warning">Cửa hàng</a></li>
                        <li><a asp-controller="Product" asp-action="List" class="text-white-50 text-decoration-none small hover-text-warning">Quản lý món ăn</a></li>
                        <li><a asp-controller="Categories" asp-action="Index" class="text-white-50 text-decoration-none small hover-text-warning">Quản lý danh mục</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-12">
                    <h6 class="text-white fw-bold mb-3">Chính sách & Hỗ trợ</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                        <li><a href="#" class="text-white-50 text-decoration-none small hover-text-warning">Điều khoản sử dụng</a></li>
                        <li><a href="#" class="text-white-50 text-decoration-none small hover-text-warning">Chính sách bảo mật</a></li>
                        <li><a href="#" class="text-white-50 text-decoration-none small hover-text-warning">Chính sách vận chuyển</a></li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary my-4 opacity-25">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center small text-white-50">
                <div>
                    &copy; 2026 Nguyễn Hải Đăng. Thiết kế học tập.
                </div>
                <div class="mt-2 mt-md-0">
                    <span class="me-3"><i class="fa-solid fa-phone me-1 text-warning"></i> 1900 xxxx</span>
                    <span><i class="fa-solid fa-envelope me-1 text-warning"></i> contact@yummybite.com</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
