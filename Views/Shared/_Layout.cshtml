<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Claude Store</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NguyenHaiDang_W345.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark sticky-top px-3">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Product" asp-action="Index">
                    <img src="~/images/claudecode-color.png" alt="Logo" height="40" class="me-2 rounded">
                    <span class="fw-bold text-white fs-5">Claude Store</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Product" asp-action="Index">
                                <i class="fa-solid fa-house me-1"></i> Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Product" asp-action="Add">
                                <i class="fa-solid fa-plus me-1"></i> Thêm sản phẩm
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Product" asp-action="List">
                                <i class="fa-solid fa-table me-1"></i> List Product
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Categories" asp-action="Index">
                                <i class="fa-solid fa-list me-1"></i> Danh mục
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        <form class="d-flex m-0" asp-controller="Product" asp-action="Index" method="get">
                            <input class="form-control" type="search" name="keyword" placeholder="Tìm kiếm sản phẩm...">
                            <button class="btn btn-outline-light" type="submit">Tìm</button>
                        </form>

                        <a href="#" class="btn btn-outline-light rounded-pill position-relative px-3 py-2">
                            <i class="fa-solid fa-cart-shopping me-1"></i>
                            <span class="d-none d-sm-inline">Giỏ hàng</span>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger shadow">0</span>
                        </a>

                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white-50 py-5 mt-5">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 mb-4 mb-md-0 text-center text-md-start">
                    <h5 class="text-white fw-bold d-flex align-items-center justify-content-center justify-content-md-start">
                        <img src="~/images/claudecode-color.png" alt="Logo" height="30" class="me-2 rounded">
                        Claude Store
                    </h5>
                    <p class="small text-white-50 mt-2 mb-3">
                        Website bán lẻ thiết bị công nghệ chính hãng. Bài tập thực hành Lập trình Web.
                    </p>
                    <div class="d-flex justify-content-center justify-content-md-start gap-3">
                        <a href="#" class="text-white-50"><i class="fab fa-facebook-f fs-5"></i></a>
                        <a href="#" class="text-white-50"><i class="fab fa-instagram fs-5"></i></a>
                        <a href="#" class="text-white-50"><i class="fab fa-youtube fs-5"></i></a>
                    </div>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <div class="d-flex justify-content-center justify-content-md-end gap-3 mb-0">
                        <a href="#" class="text-white-50 text-decoration-none small">Giới thiệu</a>
                        <a href="#" class="text-white-50 text-decoration-none small">Dịch vụ</a>
                        <a href="#" class="text-white-50 text-decoration-none small">Liên hệ</a>
                        <a href="#" class="text-white-50 text-decoration-none small">Điều khoản</a>
                    </div>
                </div>
            </div>
            <hr class="border-secondary my-4">
            <div class="text-center small text-white-50">
                &copy; 2026 Nguyễn Hải Đăng. Sản phẩm thiết kế phục vụ mục đích học tập.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
