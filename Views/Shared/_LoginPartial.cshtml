@using Microsoft.AspNetCore.Identity
@using NguyenHaiDang_W345.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav flex-row align-items-center gap-2">
@if (SignInManager.IsSignedIn(User))
{
    @if (User.IsInRole(SD.Role_Admin))
    {
        <li class="nav-item">
            <a class="btn btn-danger rounded-pill px-3 py-2" asp-area="Admin" asp-controller="Admin" asp-action="Index">
                <i class="fa-solid fa-user-shield me-1"></i> Admin
            </a>
        </li>
    }
    <li class="nav-item">
        <a id="manage" class="nav-link text-white px-2" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
            <i class="fa-solid fa-user me-1"></i> Hello @UserManager.GetUserName(User)!
        </a>
    </li>
    <li class="nav-item">
        <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Product", new { area = "" })" method="post">
            <button id="logout" type="submit" class="btn btn-outline-light rounded-pill px-3 py-2">
                <i class="fa-solid fa-right-from-bracket me-1"></i> Logout
            </button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="btn btn-outline-light rounded-pill px-3 py-2" id="register" asp-area="Identity" asp-page="/Account/Register">
            <i class="fa-solid fa-user-plus me-1"></i> Register
        </a>
    </li>
    <li class="nav-item">
        <a class="btn btn-light rounded-pill px-3 py-2" id="login" asp-area="Identity" asp-page="/Account/Login">
            <i class="fa-solid fa-right-to-bracket me-1"></i> Login
        </a>
    </li>
}
</ul>
