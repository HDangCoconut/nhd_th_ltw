@model Category

@{
    ViewData["Title"] = "Category Details";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="mb-1">@Model.Name</h2>
        <p class="text-muted mb-0">Products in this category.</p>
    </div>
    <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-primary">Edit Category</a>
</div>

@if (Model.Products.Count > 0)
{
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Price</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model.Products)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.Price.ToString("N0")</td>
                    <td>
                        <a asp-controller="Product" asp-action="Display" asp-route-id="@product.Id">View Product</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">This category does not contain any products.</div>
}

<a asp-action="Index" class="btn btn-secondary">Back to List</a>
