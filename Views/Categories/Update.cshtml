@model Category

@{
    ViewData["Title"] = "Cập nhật danh mục";
}

<div class="container py-4" style="max-width: 600px;">
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom border-light">
        <div>
            <h2 class="mb-1 fw-bold text-dark">Sửa danh mục</h2>
            <p class="text-muted mb-0">Chỉnh sửa tên danh mục phân loại món ăn.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 bg-white">
            <form asp-action="Update" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label asp-for="Name" class="form-label fw-bold text-dark">Tên danh mục</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-accent rounded-pill px-4 py-2.5 fw-bold flex-grow-1">
                        <i class="fa-solid fa-square-check me-1"></i> Lưu thay đổi
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2.5">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
