@model IEnumerable<Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="mb-1">Categories</h2>
        <p class="text-muted mb-0">Manage product categories.</p>
    </div>
    <a asp-action="Add" class="btn btn-primary">Add Category</a>
</div>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Name</th>
            <th class="text-nowrap">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td class="fw-semibold">@category.Name</td>
                <td class="text-nowrap">
                    <a asp-action="Display" asp-route-id="@category.Id" class="btn btn-sm btn-outline-info">View</a>
                    <a asp-action="Update" asp-route-id="@category.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
