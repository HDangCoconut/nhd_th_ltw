@model IEnumerable<Category>

@{
    ViewData["Title"] = "Danh mục sản phẩm";
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom border-light">
        <div>
            <h2 class="mb-1 fw-bold text-dark">Danh mục món ăn</h2>
            <p class="text-muted mb-0">Quản lý các phân loại danh mục trong thực đơn cửa hàng.</p>
        </div>
        <a asp-action="Add" class="btn btn-accent rounded-pill px-4 py-2.5 d-flex align-items-center gap-1">
            <i class="fa-solid fa-plus"></i> Thêm danh mục mới
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-4 bg-white">
            <div class="table-responsive">
                <table class="table table-hover align-middle w-100">
                    <thead>
                        <tr>
                            <th>Tên danh mục</th>
                            <th class="text-center" style="width: 280px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark" style="font-size: 1.05rem;">
                                    <i class="fa-solid fa-folder-open text-warning me-2"></i>@category.Name
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="Display" asp-route-id="@category.Id" class="btn btn-sm btn-outline-accent rounded-pill px-3 py-1.5 d-flex align-items-center gap-1" style="font-size: 0.8rem;">
                                            <i class="fa-regular fa-eye"></i> Xem món
                                        </a>
                                        <a asp-action="Update" asp-route-id="@category.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1.5 d-flex align-items-center gap-1" style="font-size: 0.8rem;">
                                            <i class="fa-regular fa-pen-to-square"></i> Sửa
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1.5 d-flex align-items-center gap-1" style="font-size: 0.8rem;">
                                            <i class="fa-regular fa-trash-can"></i> Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
